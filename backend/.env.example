# PostgreSQL Connection String
DATABASE_URL=postgresql://tesserak:tesserak123@localhost:5432/tesserak

# Optional dedicated read-only AWS IAM credentials for global catalog endpoints
# (EKS versions, add-on versions, EKS public SSM AMIs, EC2 instance type catalog)
# TESSERAK_CATALOG_AWS_ACCESS_KEY_ID=
# TESSERAK_CATALOG_AWS_SECRET_ACCESS_KEY=
# TESSERAK_CATALOG_AWS_REGION=us-east-1

# Auth0 FastAPI Configuration (optional)
# Copy this file to backend/.env if enabling backend Auth0 JWT verification
# AUTH0_DOMAIN=your-tenant.us.auth0.com
# AUTH0_AUDIENCE=https://api.tesserak.local

# Email OTP Verification SMTP Configuration (optional for local development)
# When SMTP_HOST is unset, registration generates a local preview OTP shown in the UI.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-account@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=Tesserak Auth <no-reply@tesserak.local>
# SMTP_USE_TLS=true
