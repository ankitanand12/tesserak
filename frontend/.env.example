# Auth0 React SPA Configuration (optional — Tesserak falls back to local dev login when omitted)
# Copy this file to frontend/.env and fill in your Auth0 tenant values.
REACT_APP_AUTH0_DOMAIN=your-tenant.us.auth0.com
REACT_APP_AUTH0_CLIENT_ID=your-auth0-spa-client-id
# Optional API audience if protecting backend FastAPI routes with Auth0 JWTs
# REACT_APP_AUTH0_AUDIENCE=https://api.tesserak.local
