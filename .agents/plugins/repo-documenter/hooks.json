{
  "repo-documenter": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 ./scripts/track_repo_changes.py",
        "timeout": 10
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 ./scripts/track_repo_changes.py",
        "timeout": 10
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(edit_file|write_file|replace_file_content|write_to_file|multi_replace_file_content|delete_file|move_file|apply_patch|patch_file|run_command)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/track_repo_changes.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 ./scripts/track_repo_changes.py",
        "timeout": 10
      }
    ]
  }
}
